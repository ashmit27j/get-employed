# GetEmployed environment. Copy to .env at the repo root; every app reads this one file.
# Nothing here is a real secret. Variables marked (later) are read by features built in later phases.

# ─── Mode ────────────────────────────────────────────────────────────────────
# true = running on your own machine with your own keys: cost caps configurable.
# The site looks the same either way; only how work is processed changes.
SELF_HOSTED=true
NODE_ENV=development

# ─── URLs (placeholders; no domains yet) ─────────────────────────────────────
# The one public URL: marketing pages and the app are served together (apps/app).
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# ─── Database and queue ──────────────────────────────────────────────────────
# Postgres 13+. The queue (pg-boss) lives in the same database, so there is no Redis.
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgres://getemployed:getemployed@localhost:5432/getemployed
# Password for the seeded demo user (sign in as "ashmit"). The default is public, so the seed
# refuses it when NODE_ENV=production; set your own before seeding anything shared.
SEED_PASSWORD=getemployed-demo

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random string, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials).
# Sign-in uses openid/email/profile only. Leave empty to use email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Transactional email: reset codes, verification (later) ─────────────────
# Use Resend, or leave empty and fill SMTP_* below.
RESEND_API_KEY=
EMAIL_FROM="GetEmployed <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Outreach sending ────────────────────────────────────────────────────────
# Gmail sending uses the Google client above with the gmail.send scope, requested when a
# user connects their mailbox. Key used to encrypt stored mailbox credentials (32 bytes, base64).
MAILBOX_ENCRYPTION_KEY=

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Gemini powers search parsing, match reasons, tailoring, drafts, the Assistant and interviews.
# Server-side only. Without a key every feature falls back to its rule-based version, and a
# user can save their own key in Settings → Developer.
LLM_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemini-flash-latest
INTERVIEW_MODEL=gemini-flash-latest

# ─── Interviews: text-to-speech and caps ─────────────────────────────────────
# Google Cloud TTS service account: path to the JSON key, or the JSON itself.
GOOGLE_TTS_CREDENTIALS=
TTS_WAVENET_VOICE=en-IN-Wavenet-A
TTS_STANDARD_VOICE=en-IN-Standard-A
# Free-tier sizes (characters per month) and the share we allow ourselves to use.
TTS_WAVENET_MONTHLY_LIMIT=1000000
TTS_STANDARD_MONTHLY_LIMIT=4000000
TTS_SAFETY_RATIO=0.9
# Sessions per user per month. Empty = no cap (default when SELF_HOSTED=true).
INTERVIEW_MONTHLY_SESSION_CAP=
# Browser fallback model for speech-to-text when the Web Speech API fails.
NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-tiny.en

# ─── Job sources ─────────────────────────────────────────────────────────────
# Internal scraper service (apps/scraper). Shared secret: at least 16 characters.
SCRAPER_URL=http://localhost:8000
SCRAPER_SHARED_SECRET=
# LinkedIn guest-page scraping. Read docs/job-ingestion.md before enabling.
LINKEDIN_SCRAPING_ENABLED=false
LINKEDIN_MIN_INTERVAL_S=2.5
# Adzuna job search API (developer.adzuna.com), free key. Greenhouse/Lever/Ashby need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Company boards refresh when older than this; searches run keyword sources on demand.
# (SEARCH_FRESHNESS_MINUTES below.) Open jobs not seen for this many days are closed.
JOB_STALE_DAYS=21
# Tectonic compiles resume PDFs in the worker (the Docker image includes it). Unset = "tectonic".
TECTONIC_BIN=
# Minutes before cached search results trigger a fresh ingest.
SEARCH_FRESHNESS_MINUTES=60

# ─── Profiles (later) ────────────────────────────────────────────────────────
# GitHub token for reading public repos (raises the rate limit). No scopes needed.
GITHUB_TOKEN=

# ─── File storage (S3-compatible; SeaweedFS locally) ─────────────────────────
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=getemployed
S3_ACCESS_KEY_ID=getemployed
S3_SECRET_ACCESS_KEY=getemployed-secret
S3_FORCE_PATH_STYLE=true

# ─── Billing (TODO, not built: docs/decisions.md D15) ────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
